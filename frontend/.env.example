VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Only emails on this domain can request a sign-in code (default: srmist.edu.in)
VITE_ALLOWED_EMAIL_DOMAIN=srmist.edu.in
# Optional comma-separated addresses allowed outside the domain (e.g. faculty)
VITE_EXTRA_ALLOWED_EMAILS=

# Production lab: https://smm-virtual-lab.vercel.app/
# In Supabase Auth URL config, Site URL + Redirect URLs must include that origin.
